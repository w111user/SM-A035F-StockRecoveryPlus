#!/system/bin/sh

if [ -e /dev/block/mapper/system ] || [ -L /dev/block/mapper/system ]; then
    exit 0
fi

/system/bin/lpmode || true

i=0
while [ "$i" -lt 20 ]; do
    if [ -e /dev/block/mapper/system ] || [ -L /dev/block/mapper/system ]; then
        exit 0
    fi
    sleep 0.05
    i=$((i + 1))
done

exit 1
